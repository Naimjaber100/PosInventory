{
  "ConnectionStrings": {
    "DefaultConnection": "Host=192.168.1.111;Port=5432;Database=Pos;Username=postgres;password=Admin@1234"
  },

  "ScaleBarcode": {
    "Enabled": true,
    "Length": 12,
    "WeightPrefixes": [ "21", "23" ],
    "PricePrefixes": [ "22", "24","27"],
    "ItemCodeStart": 2,
    "ItemCodeLength": 4,
    "ValueStart": 6,
    "ValueLength": 6,
    "WeightDecimals": 3,
    "PriceDecimals": 0,
    "CheckDigit": false
  },

  "ReceiptPrinter": {
    "Enabled": true,
    "PrinterName": "XP-80C (copy 1)",
    "PrintAfterSale": true,
    "Copies": 1,
    "PaperWidthMm": 80,
    "EscPos": true
  },

  "CustomerDisplay": {
    "Enabled": false,
    "Type": "Screen",
    "Screen": 0,
    "Port": "COM3",
    "BaudRate": 9600,
    "Commands": "EscPos",
    "LineWidth": 20,
    "WelcomeText": "Welcome",
    "ThankYouText": "Thank you!",
    "ThankYouSeconds": 20
  },

  "Backup": {
    "Folder": "",
    "PgDumpPath": "",
    "KeepLast": 30
  },

  "OpenAI": {
    "ApiKey": "PUT-THE-KEY-IN-appsettings.local.json-NOT-HERE",
    "Model": "gpt-4o",
    "TranscriptionModel": "gpt-4o-transcribe",
    "TranscriptionLanguage": "",
    "BaseUrl": "https://api.openai.com/v1",
    "TimeoutSeconds": 120
  }
