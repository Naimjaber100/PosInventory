{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=Pos;Username=postgres"
  },

  "ScaleBarcode": {
    "Enabled": true,
    "Length": 13,
    "WeightPrefixes": [ "21", "23" ],
    "PricePrefixes": [ "22", "24" ],
    "ItemCodeStart": 2,
    "ItemCodeLength": 5,
    "ValueStart": 7,
    "ValueLength": 5,
    "WeightDecimals": 3,
    "PriceDecimals": 0,
    "CheckDigit": true
  },

  "ReceiptPrinter": {
    "Enabled": true,
    "PrinterName": "",
    "PrintAfterSale": true,
    "Copies": 1,
    "PaperWidthMm": 80
  },

  "Backup": {
    "Folder": "",
    "PgDumpPath": "",
    "KeepLast": 30
  },

  "OpenAI": {
    "ApiKey": "PUT-THE-KEY-IN-appsettings.local.json-NOT-HERE",
    "Model": "gpt-4o",
    "TranscriptionModel": "gpt-4o-transcribe",
    "TranscriptionLanguage": "",
    "BaseUrl": "https://api.openai.com/v1",
    "TimeoutSeconds": 120
  }
}
